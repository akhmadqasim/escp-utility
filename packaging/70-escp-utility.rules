# escp-utility: give the user of the active local session read/write access to
# the usblp node (/dev/usb/lpN) of every Epson USB printer (vendor 04b8). The
# app uses it only to read the printer status (the IEEE 1284.4 "st" request).
# Without this rule the node is root:lp 0660 on a stock system, and the app
# works without status.
#
# Install:
#   sudo install -m 644 packaging/70-escp-utility.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=usbmisc
# (or unplug and replug the printer)
SUBSYSTEM=="usbmisc", KERNEL=="lp*", ATTRS{idVendor}=="04b8", TAG+="uaccess"
