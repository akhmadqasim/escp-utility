[Desktop Entry]
Type=Application
Name=Epson L800 Utility
GenericName=Printer Maintenance
Comment=Printing Preferences and maintenance for the Epson L800 (layout of the Windows driver)
Exec=/home/akhmadqasim/code/epson-l800-utility/target/release/epson-l800-utility --utility
Icon=epson-l800-utility
Terminal=false
Categories=Settings;HardwareSettings;Printing;
Keywords=Epson;L800;printer;nozzle;cleaning;preferences;
StartupWMClass=epson-l800-utility
Actions=preferences;dry-run;

[Desktop Action preferences]
Name=Printing Preferences
Exec=/home/akhmadqasim/code/epson-l800-utility/target/release/epson-l800-utility

[Desktop Action dry-run]
Name=Dry Run (nothing is sent or saved)
Exec=/home/akhmadqasim/code/epson-l800-utility/target/release/epson-l800-utility --utility --dry-run
