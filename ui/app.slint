// Layout of the Windows Epson L800 driver's Maintenance tab and utility dialogs.
//
// Every rectangle is the dialog-unit (DLU) rectangle from the driver resources,
// converted to pixels at 96 dpi with the dialog font:
//   E_IUIRG5P.DLL dialog 903 "Maintenance" (295 x 267 DLU -> 443 x 434 px page)
//   E_IHSRG5P.DLL dialogs 201, 210, 211, 226 (= 220), 227 (= 224), 271, 360
// All templates use FONT 8, "MS Shell Dlg 2" = Tahoma 8 pt, whose dialog base
// units are 6 x 13 px, so px_x = MulDiv(dlu_x, 6, 4) and px_y = MulDiv(dlu_y, 13, 8)
// (each field rounded on its own, like USER32). The Maintenance tab uses the
// px values in phase2/layout/LAYOUT.md; the dialogs are re-spaced (see
// "Utility dialogs" below).
//
// Button, tab and title labels are the Windows (English) strings. The long
// paragraphs are our own wording, set from Rust (src/texts.rs).
// All icons and pictures are our own SVGs (ui/icons), drawn where Windows
// draws its bitmaps and at the same size.

import { Button, ComboBox, Palette, TextEdit } from "std-widgets.slint";

import { Strings, DlgText, EtchedLine, DlgButton, IconButton, Radio, DlgIcon, FramedWindow, UtilityWindow, InkLevel, InkMeter, CheckBox, Frame } from "common.slint";
import { Prefs, ShortcutsPage, MainPage, AdvancedPage, PageLayoutPage } from "pages.slint";
import { ColorControlsDialog, LayoutDialog, LayoutKind, LayoutControl } from "dialogs.slint";
export { InkLevel, Prefs, Frame, ColorControlsDialog, LayoutDialog, LayoutKind, LayoutControl }

export struct UtilityRow {
    id: string,
    title: string,
    description: string,
    icon: image,
    enabled: bool,
    // tooltip while disabled: why
    tip: string,
    // px rows from LAYOUT.md: title, button, etched line, description
    title-y: length,
    title-w: length,
    button-y: length,
    line-y: length,
    desc-y: length,
}

// ---------------------------------------------------------------------------
// Dialog 903 "Maintenance" (295x267 DLU = 443x434 px).
component MaintenancePage inherits Rectangle {
    in property <string> version-text;
    // The printer takes the maintenance jobs (ESC/P device ID or a profile).
    in property <bool> maintenance: true;
    // Its profile has no `tested` entry (profiles.toml).
    in property <bool> experimental;
    // Paper Guide Cleaning: the L800's only (profile windows_family G5P).
    in property <bool> paper-guide: true;
    callback utility-clicked(string);
    callback driver-update();
    width: 443px;
    height: 434px;
    background: #ffffff;

    // Six slots, filled like E_IUICG5P FUN_68fd966c: table order Status
    // Monitor 3, Auto Nozzle Check, Nozzle Check, Head Cleaning, Print Head
    // Alignment, Ink Cartridge Replacement, Paper Guide Cleaning, Printer and
    // Option Information, keeping the entries the model supports. For the L800,
    // rows 2-4 are certain; SM3, Paper Guide Cleaning and Printer and Option
    // Information are probable (capability calls not resolved statically).
    // Titles: E_IUIRG5P strings 3950-3957, descriptions 3958-3965.
    property <[UtilityRow]> utilities: [
        { id: "status-monitor", title: "EPSON Status Monitor 3",
          description: "Use this utility to automatically check for errors and also check the level of ink remaining.",
          icon: @image-url("icons/status-monitor.svg"), enabled: true, tip: "",
          title-y: 10px, title-w: 300px, button-y: 11px, line-y: 28px, desc-y: 33px },
        { id: "nozzle-check", title: "Nozzle Check",
          description: "Use this utility if gaps or faint areas appear in your printout.",
          icon: @image-url("icons/nozzle-check.svg"), enabled: true, tip: "",
          title-y: 72px, title-w: 197px, button-y: 73px, line-y: 89px, desc-y: 94px },
        { id: "head-cleaning", title: "Head Cleaning",
          description: "Use this utility if your print quality declines or the Nozzle Check indicates clogged nozzles.",
          icon: @image-url("icons/head-cleaning.svg"), enabled: true, tip: "",
          title-y: 133px, title-w: 300px, button-y: 135px, line-y: 151px, desc-y: 156px },
        { id: "head-alignment", title: "Print Head Alignment",
          description: "Use this utility if misaligned vertical lines appear in your printout.",
          icon: @image-url("icons/head-alignment.svg"), enabled: false, tip: Strings.alignment-off,
          title-y: 195px, title-w: 300px, button-y: 197px, line-y: 213px, desc-y: 218px },
        { id: "paper-guide-cleaning", title: "Paper Guide Cleaning",
          description: "Use this utility if your printout is dirty.",
          icon: @image-url("icons/paper-guide.svg"), enabled: true, tip: "",
          title-y: 257px, title-w: 300px, button-y: 258px, line-y: 275px, desc-y: 280px },
        { id: "printer-info", title: "Printer and Option Information",
          description: "Use this utility to create or verify settings for your printer and optional devices.",
          icon: @image-url("icons/printer-info.svg"), enabled: true, tip: "",
          title-y: 319px, title-w: 300px, button-y: 320px, line-y: 336px, desc-y: 341px },
    ];

    // The jobs need the maintenance gate; Status Monitor 3 and the CUPS
    // information work for any printer.
    pure function row-enabled(u: UtilityRow) -> bool {
        u.enabled && (root.maintenance || u.id == "status-monitor" || u.id == "printer-info")
            && (root.paper-guide || u.id != "paper-guide-cleaning")
    }
    pure function row-tip(u: UtilityRow) -> string {
        root.row-enabled(u) ? "" : !u.enabled ? u.tip : !root.maintenance ? Strings.no-escp : Strings.paper-guide-off
    }

    for u in root.utilities: Rectangle {
        // 3906-3911 OWNERDRAW (40,7+38n, 27x26 DLU)
        IconButton {
            x: 60px;
            y: u.button-y;
            width: 41px;
            height: 42px;
            icon: u.icon;
            enabled: root.row-enabled(u);
            tip: root.row-tip(u);
            clicked => { root.utility-clicked(u.id); }
        }
        // 3900-3905 LTEXT (77,6+38n, 200x8 DLU)
        DlgText {
            x: 116px;
            y: u.title-y;
            width: u.title-w;
            height: 13px;
            text: u.title;
            wrap: no-wrap;
            color: root.row-enabled(u) ? #000000 : #8a8a8a;
        }
        // 3918-3923 ETCHEDHORZ (77,17+38n, 200x2 DLU)
        EtchedLine {
            x: 116px;
            y: u.line-y;
            width: 300px;
        }
        // 3912-3917 LTEXT (77,20+38n, 200x18 DLU)
        DlgText {
            x: 116px;
            y: u.desc-y;
            width: 300px;
            height: 29px;
            text: u.description;
            color: root.row-enabled(u) ? #000000 : #8a8a8a;
        }
    }

    // 3929 LTEXT "Language" (23,232,46x8 DLU)
    DlgText { x: 35px; y: 377px; width: 69px; height: 13px; text: "Language"; wrap: no-wrap; }
    // 3930 COMBOBOX droplist (71,231,134 DLU wide; closed height 21 px)
    ComboBox {
        x: 107px;
        y: 375px;
        width: 201px;
        height: 21px;
        model: ["English"];
        current-index: 0;
    }
    // 3927 PUSHBUTTON "Speed && Progress..." (210,230,77x14 DLU)
    DlgButton {
        x: 315px; y: 374px; width: 116px; height: 23px;
        text: "Speed & Progress...";
        enabled: false;
        tip: Strings.speed-off;
    }
    // 3928 PUSHBUTTON "Driver Update" (210,248,77x14 DLU)
    DlgButton {
        x: 315px; y: 403px; width: 116px; height: 23px;
        text: "Driver Update";
        clicked => { root.driver-update(); }
    }
    // 3926 LTEXT (19,251,60x8 DLU): version text
    DlgText { x: 29px; y: 408px; width: 90px; height: 13px; text: "Version " + root.version-text; wrap: no-wrap; }
    // Ours: the maintenance jobs are not yet confirmed on this model.
    if root.experimental: Rectangle {
        x: 125px; y: 408px; width: 184px; height: 13px;
        DlgText { width: 100%; height: 100%; text: "Experimental on this model"; wrap: no-wrap; color: #b35900; }
        Tooltip { text: @markdown("\{Strings.experimental}"); }
    }
}

// One tab of the property sheet: 16x16 icon + the page caption (PSP_USEICONID,
// no PSP_USETITLE, so the label is the dialog caption).
component SheetTab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    width: 30px + label.preferred-width;
    height: root.selected ? 23px : 21px;
    y: root.selected ? 0 : 2px;
    background: root.selected ? #ffffff : ta.has-hover ? #e5f1fb : #f0f0f0;
    border-width: 1px;
    border-color: #adadad;
    Image { x: 6px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icon; }
    label := DlgText { x: 26px; height: parent.height; vertical-alignment: center; text: root.text; wrap: no-wrap; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---------------------------------------------------------------------------
// Main window: the "Printing Preferences" property sheet. E_IUICG5P adds the
// five pages unconditionally in this order (LAYOUT.md §7.1): Shortcuts (904),
// Main (900), Advanced (901), Page Layout (902), Maintenance (903). Sheet
// buttons come from the comctl32 template: 75x23 px, 6 px apart, right-aligned;
// tab control at (6,7). The tab strip height and insets depend on the Windows
// theme, so the frame is approximate. Help is disabled (no help file here).
export component MainWindow inherits FramedWindow {
    in property <string> queue: "L800";
    in property <bool> dry-run;
    in property <string> version-text;
    in property <bool> maintenance: true;
    in property <bool> experimental;
    in property <bool> paper-guide: true;
    in-out property <int> current-tab: 1;
    // A utility dialog is open: like Windows' modal dialogs, ignore clicks here.
    in property <bool> busy;
    callback utility-clicked(string);
    callback driver-update();
    callback ok();
    callback cancel();
    callback apply();

    property <length> tab-strip-h: 23px;
    property <length> inset: 2px;
    property <length> page-y: 7px + root.tab-strip-h;

    title: root.queue + " Printing Preferences" + (root.dry-run ? "  (dry run: nothing is sent or saved)" : "");
    width: 6px + root.inset + 443px + root.inset + 6px;
    client-height: root.page-y + root.inset + 434px + root.inset + 7px + 23px + 7px;
    default-font-size: 10.75px;
    default-font-family: "Liberation Sans";
    background: #f0f0f0;
    init => { Palette.color-scheme = ColorScheme.light; }

    // Tab display area with the 443x434 px page.
    Rectangle {
        x: 6px;
        y: root.page-y - 1px;
        width: 443px + 2 * root.inset;
        height: 434px + 2 * root.inset;
        background: #ffffff;
        border-width: 1px;
        border-color: #adadad;
        Rectangle {
            x: root.inset;
            y: root.inset;
            width: 443px;
            height: 434px;
            if root.current-tab == 0: ShortcutsPage { }
            if root.current-tab == 1: MainPage { }
            if root.current-tab == 2: AdvancedPage { }
            if root.current-tab == 3: PageLayoutPage { }
            if root.current-tab == 4: MaintenancePage {
                version-text: root.version-text;
                maintenance: root.maintenance;
                experimental: root.experimental;
                paper-guide: root.paper-guide;
                utility-clicked(id) => { root.utility-clicked(id); }
                driver-update => { root.driver-update(); }
            }
        }
    }

    HorizontalLayout {
        x: 6px;
        y: 7px;
        height: root.tab-strip-h;
        alignment: start;
        for t[i] in [
            { text: "Shortcuts", icon: @image-url("icons/tab-shortcuts.svg") },
            { text: "Main", icon: @image-url("icons/tab-main.svg") },
            { text: "Advanced", icon: @image-url("icons/tab-advanced.svg") },
            { text: "Page Layout", icon: @image-url("icons/tab-layout.svg") },
            { text: "Maintenance", icon: @image-url("icons/tab-maintenance.svg") },
        ]: Rectangle {
            width: tab.width;
            tab := SheetTab {
                text: t.text;
                icon: t.icon;
                selected: root.current-tab == i;
                clicked => { root.current-tab = i; }
            }
            // The selected tab joins the page.
            if root.current-tab == i: Rectangle { x: 1px; y: parent.height - 1px; width: tab.width - 2px; height: 2px; background: #ffffff; }
        }
    }

    property <length> btn-y: root.client-height - 7px - 23px;
    DlgButton { x: root.width - 6px - 4 * 75px - 3 * 6px; y: root.btn-y; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
    DlgButton { x: root.width - 6px - 3 * 75px - 2 * 6px; y: root.btn-y; width: 75px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: root.width - 6px - 2 * 75px - 6px; y: root.btn-y; width: 75px; height: 23px; text: "Apply"; enabled: Prefs.dirty; clicked => { root.apply(); } }
    // Windows shows Help when the driver's help file is present (PSP_HASHELP).
    DlgButton { x: root.width - 6px - 75px; y: root.btn-y; width: 75px; height: 23px; text: "Help"; enabled: false; tip: Strings.no-help; }

    // Swallow clicks while a utility dialog is open.
    // While a utility dialog is open the sheet is inert, like a Windows
    // modal owner: clicks are swallowed, and this scope takes the keyboard
    // focus so no key reaches a page control.
    if root.busy: FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => { accept }
        TouchArea { }
    }
}

export struct SettingLine {
    label: string,
    value: string,
}

// Dialog 4050 "Current Settings" (142x305 DLU = 213x496 px), opened by
// Show Settings: a summary of the settings (labels: strings 4053-4079, filled
// from Rust), the "Always show current settings." box and Close.
export component CurrentSettingsDialog inherits UtilityWindow {
    in property <[SettingLine]> lines;
    callback dismiss();
    title: "Current Settings";
    width: 213px;
    client-height: 496px;
    default-action => { root.dismiss(); }
    cancel-action => { root.dismiss(); }
    // 4051 BLACKFRAME
    Rectangle {
        x: 8px; y: 8px; width: 197px; height: 429px;
        background: #ffffff;
        border-width: 1px;
        border-color: #000000;
        for l[i] in root.lines: Rectangle {
            x: 6px;
            y: 6px + i * 34px;
            width: parent.width - 12px;
            height: 32px;
            DlgText { x: 0; y: 0; width: parent.width; height: 13px; text: l.label; wrap: no-wrap; font-weight: 700; }
            DlgText { x: 8px; y: 14px; width: parent.width - 8px; height: 13px; text: l.value; wrap: no-wrap; overflow: elide; }
        }
    }
    CheckBox { x: 8px; y: 443px; width: 197px; height: 16px; text: "Always show current settings."; enabled: false; tip: Strings.windows-only; }
    DlgButton { x: 130px; y: 465px; width: 75px; height: 23px; text: "Close"; clicked => { root.dismiss(); } }
}

// Shown at start when CUPS has several Epson queues, or none, and no
// --queue was given (Windows opens Printing Preferences per printer).
export component ChooserDialog inherits UtilityWindow {
    in property <[string]> queues;
    in-out property <int> selected;
    callback ok();
    callback cancel();
    property <length> list-y: t.y + t.height + 8px;
    property <length> buttons-y: max(40px, root.list-y + root.queues.length * 22px) + 16px;
    title: "Printing Preferences";
    width: 371px;
    client-height: root.buttons-y + 31px;
    default-action => {
        if (root.queues.length > 0) {
            root.ok();
        }
    }
    cancel-action => { root.cancel(); }
    DlgIcon { x: 8px; y: 8px; source: @image-url("icons/printer-info.svg"); }
    t := DlgText {
        x: 48px; y: 10px; width: 315px; height: self.preferred-height;
        text: root.queues.length > 0 ? "Choose the printer:" : "No Epson printer is set up in CUPS. Add the printer in the system's printer settings, then start this utility again.";
    }
    for q[i] in root.queues: Radio {
        x: 48px; y: root.list-y + i * 22px; width: 315px; height: 16px;
        text: q;
        checked: root.selected == i;
        picked => { root.selected = i; }
    }
    if root.queues.length > 0: DlgButton { x: 207px; y: root.buttons-y; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
    DlgButton { x: 288px; y: root.buttons-y; width: 75px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
}

// ---------------------------------------------------------------------------
// Utility dialogs. Captions: E_IHSRG5P 1102 "Nozzle Check", 1101 "Head Cleaning".
// Buttons: 1153 OK, 1154 Print, 1155/1185 Finish, 1156 Clean, 1157/1184 Cancel,
// 1158 Start, 1159 Print Nozzle Check Pattern. Default buttons follow
// FUN_00425ef8 as traced in phase2/rea/NOTES.md.
//
// Same controls as the Windows templates, re-spaced (phase2/layout/
// TIDY-dialogs.md): 8 px margins, the 32 px icon at the top left with the
// text column at x 48, pictures centred above it, 75x23 buttons right-aligned
// 6 px apart, 16 px below the last content and 8 px above the bottom. Hidden
// controls take no space, and each window is as tall as its text.

// Dialog 201 (Windows 240x65 px): modeless "Please wait..." popup (4250).
export component WaitDialog inherits UtilityWindow {
    in property <string> utility: "Nozzle Check";
    in property <image> glyph: @image-url("icons/nozzle-check.svg");
    title: root.utility;
    width: 240px;
    client-height: 48px;
    DlgIcon { x: 8px; y: 8px; source: root.glyph; }
    DlgText { x: 48px; y: 18px; width: 184px; height: 13px; text: "Please wait..."; wrap: no-wrap; }
}

// Dialog 210 (Windows 420x374 px): Nozzle Check, step 1.
// FUN_00429db8: 517 picture, 525 instructions (4210), 500 "Cancel", 501 "Print" (default).
export component NozzleCheckDialog inherits UtilityWindow {
    in property <string> body;
    callback print();
    callback cancel();
    property <length> buttons-y: t.y + t.height + 16px;
    title: "Nozzle Check";
    width: 420px;
    client-height: root.buttons-y + 31px;
    default-action => { root.print(); }
    cancel-action => { root.cancel(); }
    // 517: picture centred over the dialog.
    Image { x: 172px; y: 8px; width: 76px; height: 72px; source: @image-url("icons/printer.svg"); }
    DlgIcon { x: 8px; y: 90px; source: @image-url("icons/nozzle-check.svg"); }
    t := DlgText { x: 48px; y: 92px; width: 364px; height: max(30px, self.preferred-height); text: root.body; }
    DlgButton { x: 256px; y: root.buttons-y; width: 75px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: 337px; y: root.buttons-y; width: 75px; height: 23px; text: "Print"; primary: true; clicked => { root.print(); } }
}

// Dialog 211 (Windows 435x414 px): Nozzle Check, step 2.
// FUN_004296e0: samples 518/519, 535 "Good" (4212), 536 "Cleaning needed" (4213),
// 525 instructions (4211), 501 "Clean", 500 "Finish" (default).
export component NozzleResultDialog inherits UtilityWindow {
    in property <string> body;
    callback clean();
    callback finish();
    property <length> buttons-y: max(196px, t.y + t.height) + 16px;
    title: "Nozzle Check";
    width: 435px;
    client-height: root.buttons-y + 31px;
    default-action => { root.finish(); }
    cancel-action => { root.finish(); }
    // 518/519 (8,y,419x50): the 348x42 samples centred.
    Image { x: 43px; y: 12px; width: 348px; height: 42px; source: @image-url("icons/nozzle-good.svg"); }
    DlgText { x: 8px; y: 62px; width: 419px; height: 13px; text: "Good"; horizontal-alignment: center; }
    Image { x: 43px; y: 87px; width: 348px; height: 42px; source: @image-url("icons/nozzle-bad.svg"); }
    DlgText { x: 8px; y: 137px; width: 419px; height: 13px; text: "Cleaning needed"; horizontal-alignment: center; }
    DlgIcon { x: 8px; y: 164px; source: @image-url("icons/nozzle-check.svg"); }
    t := DlgText { x: 48px; y: 166px; width: 379px; height: self.preferred-height; text: root.body; }
    DlgButton { x: 271px; y: root.buttons-y; width: 75px; height: 23px; text: "Clean"; clicked => { root.clean(); } }
    DlgButton { x: 352px; y: root.buttons-y; width: 75px; height: 23px; text: "Finish"; primary: true; clicked => { root.finish(); } }
}

// Dialog 226 (= 220, Windows 420x372 px): Head Cleaning, step 1, no-status variant.
// FUN_00411038: 525 instructions (4201), one radio per cleaning type of the
// profile (L800: 513 "Cleaning" (10470, default) and 514 "Power Cleaning"
// (10471) from RCDATA 10460). The description statics 528/529 stay empty,
// so they take no space. 501 "Cancel", 500 "Start" (default).
export component HeadCleaningDialog inherits UtilityWindow {
    in property <string> body;
    in property <[string]> kinds: ["Cleaning", "Power Cleaning"];
    in-out property <int> kind;
    callback start(int);
    callback cancel();
    property <length> radio-y: max(40px, t.y + t.height) + 12px;
    property <length> buttons-y: root.radio-y + (root.kinds.length - 1) * 22px + 16px + 16px;
    title: "Head Cleaning";
    width: 420px;
    client-height: root.buttons-y + 31px;
    default-action => { root.start(root.kind); }
    cancel-action => { root.cancel(); }
    DlgIcon { x: 8px; y: 8px; source: @image-url("icons/head-cleaning.svg"); }
    t := DlgText { x: 48px; y: 10px; width: 364px; height: self.preferred-height; text: root.body; }
    for k[i] in root.kinds: Radio {
        x: 48px; y: root.radio-y + i * 22px; width: 364px; height: 16px;
        text: k;
        checked: root.kind == i;
        picked => { root.kind = i; }
    }
    DlgButton { x: 256px; y: root.buttons-y; width: 75px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: 337px; y: root.buttons-y; width: 75px; height: 23px; text: "Start"; primary: true; clicked => { root.start(root.kind); } }
}

// Dialog 360 (Windows 435x414 px): Power Cleaning confirmation.
// FUN_0043ff54: 525 warning (10553), 585 illustration of the transportation
// lock, 501 "Cancel" (back to step 1), 500 "OK" (default).
export component PowerCleaningDialog inherits UtilityWindow {
    in property <string> body;
    // The L800 transportation lock (other printers: no picture).
    in property <bool> picture: true;
    callback ok();
    callback cancel();
    // 585 (8,y,419x124) under the text; the 160x120 picture centred in it.
    property <length> picture-y: max(40px, t.y + t.height) + 12px;
    property <length> buttons-y: root.picture ? root.picture-y + 124px + 16px : root.picture-y + 4px;
    title: "Head Cleaning";
    width: 435px;
    client-height: root.buttons-y + 31px;
    default-action => { root.ok(); }
    cancel-action => { root.cancel(); }
    DlgIcon { x: 8px; y: 8px; source: @image-url("icons/head-cleaning.svg"); }
    t := DlgText { x: 48px; y: 10px; width: 379px; height: self.preferred-height; text: root.body; }
    // Our picture and its two labels stay inside the 160x120 bitmap box, like Windows.
    if root.picture: Rectangle {
        x: 137px; y: root.picture-y + 2px; width: 160px; height: 120px;
        Image { width: 100%; height: 100%; source: @image-url("icons/transport-lock.svg"); }
        Text { x: 100px; y: 2px; width: 60px; text: "Printing"; font-size: 10px; color: #3a7bd5; horizontal-alignment: right; }
        Text { x: 100px; y: 106px; width: 60px; text: "Transport"; font-size: 10px; color: #6a7078; horizontal-alignment: right; }
    }
    DlgButton { x: 271px; y: root.buttons-y; width: 75px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: 352px; y: root.buttons-y; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
}

// Dialog 227 (= 224, Windows 420x335 px): Head Cleaning finished.
// FUN_0040f2fc: picture 517 hidden (no space), 525 = 4204 / 4205,
// 503 "Print Nozzle Check Pattern" (default), 500 "Finish". The text box is
// at least 48 px (4 lines), so 224 and 227 come out the same size.
export component CleaningDoneDialog inherits UtilityWindow {
    in property <string> body;
    callback nozzle-check();
    callback finish();
    property <length> buttons-y: t.y + t.height + 16px;
    title: "Head Cleaning";
    width: 420px;
    client-height: root.buttons-y + 31px;
    default-action => { root.nozzle-check(); }
    cancel-action => { root.finish(); }
    DlgIcon { x: 8px; y: 8px; source: @image-url("icons/head-cleaning.svg"); }
    t := DlgText { x: 48px; y: 10px; width: 364px; height: max(48px, self.preferred-height); text: root.body; }
    DlgButton { x: 171px; y: root.buttons-y; width: 160px; height: 23px; text: "Print Nozzle Check Pattern"; primary: true; clicked => { root.nozzle-check(); } }
    DlgButton { x: 337px; y: root.buttons-y; width: 75px; height: 23px; text: "Finish"; clicked => { root.finish(); } }
}

// Dialog 265 (Windows 420x335 px): Paper Guide Cleaning.
// FUN_0042c3d0: 516 icon (group icon 1005), 525 instructions (4220),
// 501 "Cancel", 500 "Cleaning" (1182, default). The caption string 1112 is
// absent from E_IHSRG5P, so Windows shows an empty title.
export component PaperGuideDialog inherits UtilityWindow {
    in property <string> body;
    callback cleaning();
    callback cancel();
    property <length> buttons-y: t.y + t.height + 16px;
    title: "";
    width: 420px;
    client-height: root.buttons-y + 31px;
    default-action => { root.cleaning(); }
    cancel-action => { root.cancel(); }
    DlgIcon { x: 8px; y: 8px; source: @image-url("icons/paper-guide.svg"); }
    t := DlgText { x: 48px; y: 10px; width: 364px; height: max(48px, self.preferred-height); text: root.body; }
    DlgButton { x: 256px; y: root.buttons-y; width: 75px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: 337px; y: root.buttons-y; width: 75px; height: 23px; text: "Cleaning"; primary: true; clicked => { root.cleaning(); } }
}

// Dialog 270 / 271 (Windows 371x197 px): message box. 525 heading, 526
// text under it (both as tall as their text), then the buttons.
// 271: OK. 270 (status errors): [Details] [OK]; Details opens Status Monitor 3.
export component MessageDialog inherits UtilityWindow {
    in property <string> utility;
    in property <string> heading;
    in property <string> body;
    in property <bool> show-details;
    in property <image> glyph: @image-url("icons/nozzle-check.svg");
    callback ok();
    callback details();
    property <length> buttons-y: max(40px, root.body == "" ? h.y + h.height : b.y + b.height) + 16px;
    title: root.utility;
    width: 371px;
    client-height: root.buttons-y + 31px;
    default-action => { root.ok(); }
    cancel-action => { root.ok(); }
    DlgIcon { x: 8px; y: 8px; source: root.glyph; }
    h := DlgText { x: 48px; y: 10px; width: 315px; height: self.preferred-height; text: root.heading; }
    b := DlgText { x: 48px; y: h.y + h.height + 8px; width: 315px; height: self.preferred-height; text: root.body; }
    if root.show-details: DlgButton { x: 207px; y: root.buttons-y; width: 75px; height: 23px; text: "Details"; clicked => { root.details(); } }
    DlgButton { x: 288px; y: root.buttons-y; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
}

// Our own cleaning animation for dialog 223 (Windows uses 12 bitmaps,
// E_IHBRG5P 6510-6521). A wiper arm, pivoting at the bottom centre, sweeps a
// streaky letter "A" clean: 3 frames per ink in the order black, cyan,
// magenta, yellow (rest on one side, mid-sweep, other side), alternating the
// sweep direction so each group starts where the last one ended.
component CleaningAnimation inherits Rectangle {
    in property <int> frame;
    property <int> group: Math.floor(root.frame / 3);
    property <int> step: Math.mod(root.frame, 3);
    property <bool> right-first: Math.mod(root.group, 2) == 0;
    property <color> ink: [#202020, #00a0e0, #d0168c, #f0c800][root.group];
    property <angle> arm: root.right-first ? 45deg * (1 + root.step) : 45deg * (3 - root.step);
    // Still dirty: everything before the sweep, the far half mid-sweep, nothing after.
    property <length> dirty-x: root.step == 1 && !root.right-first ? 53px : 0;
    property <length> dirty-w: root.step == 0 ? 106px : root.step == 1 ? 53px : 0;
    property <string> fan: "M 53 63 L 10.6 20.6 A 60 60 0 0 1 95.4 20.6 Z";
    width: 106px;
    height: 64px;
    Path { width: 106px; height: 64px; viewbox-width: 106; viewbox-height: 64; commands: root.fan; fill: #ffffff; stroke: #8a8a8a; stroke-width: 1px; }
    Rectangle {
        x: root.dirty-x; width: root.dirty-w; clip: true;
        Path { x: -root.dirty-x; width: 106px; height: 64px; viewbox-width: 106; viewbox-height: 64; commands: root.fan; fill: #cfcfcf; stroke: #8a8a8a; stroke-width: 1px; }
    }
    Text { x: 33px; y: 18px; width: 40px; height: 42px; text: "A"; font-size: 38px; font-weight: 900; color: root.ink; horizontal-alignment: center; }
    Rectangle {
        x: root.dirty-x; width: root.dirty-w; clip: true;
        // Bands across the letter, kept inside the fan.
        for i in 4: Rectangle { x: -root.dirty-x + 34px + i * 1px; y: 26px + i * 6px; width: 38px - i * 2px; height: 2px; background: #cfcfcf; }
    }
    Path {
        width: 106px; height: 64px; viewbox-width: 106; viewbox-height: 64;
        commands: "M 53 63 L " + (53 + 58 * cos(root.arm)) + " " + (63 - 58 * sin(root.arm));
        stroke: #505a66; stroke-width: 3px;
    }
    Rectangle { x: 50px; y: 60px; width: 6px; height: 6px; border-radius: 3px; background: #505a66; }
}

// Dialog 223 (Windows 420x335 px): Head Cleaning in progress.
// FUN_004123b8: 525 "Please wait..." (4202), 517 animation (12 frames,
// 500 ms), all buttons hidden (no space, 8 px bottom margin). FUN_00412ae8:
// once cleaning starts, 525 = 4203 and the progress bar 520 appears in the
// text column; until then the text sits beside the icon.
export component ProgressDialog inherits UtilityWindow {
    in property <string> body;
    in property <bool> bar-visible;
    in property <float> value;
    in property <bool> animate;
    in-out property <int> frame;
    title: "Head Cleaning";
    width: 420px;
    client-height: max(120px, t.y + t.height) + 8px;
    DlgIcon { x: 8px; y: 88px; source: @image-url("icons/head-cleaning.svg"); }
    // 517 (8,8,404x72): 12 frames, 106x64, centred.
    CleaningAnimation { x: 157px; y: 12px; frame: root.frame; }
    // Timer id 4: next frame every 500 ms while the dialog is open (FUN_00412da4;
    // main.rs sets animate while 223 is shown).
    Timer {
        interval: 500ms;
        running: root.animate;
        triggered => { root.frame = Math.mod(root.frame + 1, 12); }
    }
    if root.bar-visible: Rectangle {
        x: 48px;
        y: 93px;
        width: 364px;
        height: 22px;
        background: #ffffff;
        border-width: 1px;
        border-color: #a0a0a0;
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * clamp(root.value, 0, 1);
            height: parent.height - 2px;
            background: #0078d7;
        }
    }
    t := DlgText { x: 48px; y: root.bar-visible ? 128px : 90px; width: 364px; height: max(40px, self.preferred-height); text: root.body; }
}

// Read-only text window, the size of dialog 5050 "Printer and Option
// Information" (323x311 DLU = 485x505 px). Used for the CUPS queue details
// and for the dry-run hexdump.
export component TextDialog inherits UtilityWindow {
    in property <string> caption;
    in property <string> heading;
    in property <string> content;
    in property <bool> monospace;
    callback ok();
    title: root.caption;
    width: 485px;
    client-height: 505px;
    default-action => { root.ok(); }
    cancel-action => { root.ok(); }
    DlgText { x: 11px; y: 11px; width: 463px; height: 39px; text: root.heading; }
    TextEdit {
        x: 11px;
        y: 52px;
        width: 463px;
        height: 406px;
        text: root.content;
        read-only: true;
        wrap: no-wrap;
        font-size: 10.75px;
        font-family: root.monospace ? "DejaVu Sans Mono" : "Liberation Sans";
    }
    DlgButton { x: 399px; y: 470px; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
}

// EPSON Status Monitor 3, E_IASRG5P dialog 102 (319x419 DLU template),
// as Windows arranges it when opened from the Maintenance tab
// (E_IAPRG5P FUN_180033c9c, "detail" mode): status, ink levels and buttons
// stacked on a white background. Windows: 479x412 px client, from
// phase2/layout/LAYOUT.json "sm3.runtime.detail"; re-spaced per
// TIDY-dialogs.md. Epson's banner bitmap 377 is not drawn, so the title
// takes its place.
export component StatusMonitorDialog inherits UtilityWindow {
    in property <string> printer: "L800";
    in property <string> title-text;
    in property <string> body;
    in property <[InkLevel]> inks;
    // Meaning of E_IASRG5P 30699.
    in property <string> note: "The ink levels shown are estimates and can differ from the real levels. To be sure, look at the ink tanks on the printer.";
    callback ok();
    callback print-queue();
    title: "EPSON Status Monitor 3 : " + root.printer;
    width: 479px;
    client-height: 327px;
    background: #ffffff;
    default-action => { root.ok(); }
    cancel-action => { root.ok(); }
    // 384 short status title, Tahoma 12 pt.
    DlgText { x: 8px; y: 8px; width: 463px; height: 19px; text: root.title-text; font-size: 16px; wrap: no-wrap; overflow: elide; }
    // 212 read-only multi-line EDIT with WS_BORDER|WS_VSCROLL:
    // the 17 px scroll bar strip is always there (inactive while the text fits).
    Rectangle {
        x: 8px; y: 35px; width: 336px; height: 98px;
        background: #ffffff;
        border-width: 1px;
        border-color: #828790;
        DlgText { x: 4px; y: 3px; width: parent.width - 1px - 17px - 6px; height: parent.height - 6px; text: root.body; }
        Rectangle { x: parent.width - 1px - 17px; y: 1px; width: 17px; height: parent.height - 2px; background: #f0f0f0; }
    }
    // 210 printer picture: WS_BORDER (1 px black) + SS_SUNKEN.
    Rectangle {
        x: 351px; y: 35px; width: 120px; height: 98px;
        border-width: 1px;
        border-color: #000000;
        Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: #a0a0a0; }
        Rectangle { x: 1px; y: 1px; width: 1px; height: parent.height - 2px; background: #a0a0a0; }
        Rectangle { x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: #ffffff; }
        Rectangle { x: parent.width - 2px; y: 1px; width: 1px; height: parent.height - 2px; background: #ffffff; }
        Image { x: (parent.width - 76px) / 2; y: (parent.height - 72px) / 2; width: 76px; height: 72px; source: @image-url("icons/printer.svg"); }
    }
    // 30602 group box "Approximate Ink Levels" (8,139,463x149), 6 px below the message.
    Rectangle {
        x: 8px; y: 145px; width: 463px; height: 143px;
        border-width: 1px;
        border-color: #c8c8c8;
        border-radius: 3px;
    }
    Rectangle { x: 14px; y: 139px; width: 130px; height: 14px; background: #ffffff;
        DlgText { x: 3px; text: "Approximate Ink Levels"; wrap: no-wrap; }
    }
    // Meters 390-395 (45x68) and names 2700-2705 6 px under them: the six
    // L800 meters at x 33, 107, 180, 254, 327, 401, centred in the group
    // 73.6 px apart; more inks sit closer, with narrower and shorter meters
    // (their names then take two lines).
    property <length> ink-step: min(73.6px, 410px / max(1, root.inks.length - 1));
    property <length> meter-h: root.ink-step < 72px ? 56px : 68px;
    for ink[n] in root.inks: Rectangle {
        property <length> meter-w: min(45px, root.ink-step - 4px);
        // The meter's centre is the group's (x 239.5) plus the offset.
        x: 204px + Math.round((n - (root.inks.length - 1) / 2) * root.ink-step / 1px) * 1px;
        y: 159px;
        width: 72px;
        height: 100px;
        InkMeter { x: Math.floor((72px - parent.meter-w) / 2px) * 1px; y: 0; width: parent.meter-w; height: root.meter-h; ink: ink; }
        DlgText { x: (72px - min(72px, root.ink-step)) / 2; y: root.meter-h + 6px; width: min(72px, root.ink-step); height: 26px; text: ink.name; horizontal-alignment: center; }
    }
    // 30601 note, 8 px above the group bottom.
    DlgText { x: 16px; y: 254px; width: 447px; height: 26px; text: root.note; }
    // 410 "Print Queue" on the left, IDOK "OK" (default) on the right.
    DlgButton { x: 8px; y: 296px; width: 75px; height: 23px; text: "Print Queue"; clicked => { root.print-queue(); } }
    DlgButton { x: 396px; y: 296px; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
}
