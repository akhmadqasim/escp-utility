    DlgButton { x: 195px; y: 293px; width: 84px; height: 29px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: 285px; y: 293px; width: 126px; height: 29px; text: "Cleaning"; primary: true; clicked => { root.cleaning(); } }
}

// Dialog 270 / 271 (247x121 DLU = 371x197 px): message box.
// 516 (10,10), 525 (40,8,200x48), 526 (40,56,200x35).
// 271: IDOK (86,96,75x18). 270 (status errors): 508 [Details] (40,96,70x18)
// and IDOK (135,96,70x18); Details opens Status Monitor 3.
export component MessageDialog inherits UtilityWindow {
    in property <string> utility;
    in property <string> heading;
    in property <string> body;
    in property <bool> show-details;
    in property <image> glyph: @image-url("icons/nozzle-check.svg");
    callback ok();
    callback details();
    title: root.utility;
    width: 371px;
    height: 197px;
    default-action => { root.ok(); }
    cancel-action => { root.ok(); }
    DlgIcon { x: 15px; y: 16px; source: root.glyph; }
    DlgText { x: 60px; y: 13px; width: 300px; height: 78px; text: root.heading; }
    DlgText { x: 60px; y: 91px; width: 300px; height: 57px; text: root.body; }
    if root.show-details: DlgButton { x: 60px; y: 156px; width: 105px; height: 29px; text: "Details"; clicked => { root.details(); } }
    DlgButton {
        x: root.show-details ? 203px : 129px;
        y: 156px;
        width: root.show-details ? 105px : 113px;
        height: 29px;
        text: "OK";
        primary: true;
        clicked => { root.ok(); }
    }
}

// Our own cleaning animation for dialog 223 (Windows uses 12 bitmaps,
// E_IHBRG5P 6510-6521). A wiper arm, pivoting at the bottom centre, sweeps a
// streaky letter "A" clean: 3 frames per ink in the order black, cyan,
// magenta, yellow (rest on one side, mid-sweep, other side), alternating the
// sweep direction so each group starts where the last one ended.
component CleaningAnimation inherits Rectangle {
    in-out property <int> frame: 0;
    property <int> group: Math.floor(root.frame / 3);
    property <int> step: Math.mod(root.frame, 3);
    property <bool> right-first: Math.mod(root.group, 2) == 0;
    property <color> ink: root.group == 0 ? #202020 : root.group == 1 ? #00a0e0 : root.group == 2 ? #d0168c : #f0c800;
    property <angle> start: root.right-first ? 45deg : 135deg;
    property <angle> arm: root.start + (root.right-first ? 45deg : -45deg) * root.step;
    // Still dirty: everything before the sweep, the far half mid-sweep, nothing after.
    property <length> dirty-x: root.step == 1 && root.right-first ? 0 : root.step == 1 ? 53px : 0;
    property <length> dirty-w: root.step == 0 ? 106px : root.step == 1 ? 53px : 0;
    property <string> fan: "M 53 63 L 10.6 20.6 A 60 60 0 0 1 95.4 20.6 Z";
    width: 106px;
    height: 64px;
    Path { width: 106px; height: 64px; viewbox-width: 106; viewbox-height: 64; commands: root.fan; fill: #ffffff; stroke: #8a8a8a; stroke-width: 1px; }
    Rectangle {
        x: root.dirty-x; width: root.dirty-w; clip: true;
        Path { x: -root.dirty-x; width: 106px; height: 64px; viewbox-width: 106; viewbox-height: 64; commands: root.fan; fill: #cfcfcf; stroke: #8a8a8a; stroke-width: 1px; }
    }
    Text { x: 33px; y: 18px; width: 40px; height: 42px; text: "A"; font-size: 38px; font-weight: 900; color: root.ink; horizontal-alignment: center; }
    Rectangle {
        x: root.dirty-x; width: root.dirty-w; clip: true;
        // Bands across the letter, kept inside the fan.
        for i in 4: Rectangle { x: -root.dirty-x + 34px + i * 1px; y: 26px + i * 6px; width: 38px - i * 2px; height: 2px; background: #cfcfcf; }
    }
    Path {
        width: 106px; height: 64px; viewbox-width: 106; viewbox-height: 64;
        commands: "M 53 63 L " + (53 + 58 * cos(root.arm)) + " " + (63 - 58 * sin(root.arm));
        stroke: #505a66; stroke-width: 3px;
    }
    Rectangle { x: 50px; y: 60px; width: 6px; height: 6px; border-radius: 3px; background: #505a66; }
}

// Dialog 223 (280x206 DLU = 420x335 px): Head Cleaning in progress.
// FUN_004123b8: 525 "Please wait..." (4202), 517 animation (12 frames,
// 500 ms), all buttons hidden. FUN_00412ae8: once cleaning starts, 525 =
// 4203 and the custom-painted bar 520 (29,93,212x14 DLU) appears.
export component ProgressDialog inherits UtilityWindow {
    in property <string> body;
    in property <bool> bar-visible;
    in property <float> value;
    in property <bool> animate: true;
    in-out property <int> frame <=> anim.frame;
    title: "Head Cleaning";
    width: 420px;
    height: 335px;
    DlgIcon { x: 6px; y: 146px; source: @image-url("icons/head-cleaning.svg"); }
    // 517 (129,11,162x130 px): 12 frames, 106x64, centred at (157,44).
    anim := CleaningAnimation { x: 157px; y: 44px; }
    // Timer id 4: next frame every 500 ms while the dialog is open (FUN_00412da4).
    Timer {
        interval: 500ms;
        running: root.animate;
        triggered => { anim.frame = Math.mod(anim.frame + 1, 12); }
    }
    if root.bar-visible: Rectangle {
        x: 44px;
        y: 151px;
        width: 318px;
        height: 23px;
        background: #ffffff;
        border-width: 1px;
        border-color: #a0a0a0;
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * clamp(root.value, 0, 1);
            height: parent.height - 2px;
            background: #0078d7;
        }
    }
    DlgText { x: 45px; y: 187px; width: 339px; height: 98px; text: root.body; }
}

// Read-only text window, the size of dialog 5050 "Printer and Option
// Information" (323x311 DLU = 485x505 px). Used for the CUPS queue details
// and for the dry-run hexdump.
export component TextDialog inherits UtilityWindow {
    in property <string> caption;
    in property <string> heading;
    in property <string> content;
    in property <bool> monospace;
    callback ok();
    title: root.caption;
    width: 485px;
    height: 505px;
    default-action => { root.ok(); }
    cancel-action => { root.ok(); }
    DlgText { x: 11px; y: 11px; width: 463px; height: 39px; text: root.heading; }
    TextEdit {
        x: 11px;
        y: 52px;
        width: 463px;
        height: 406px;
        text: root.content;
        read-only: true;
        wrap: no-wrap;
        font-size: 11px;
        font-family: root.monospace ? "DejaVu Sans Mono" : "Liberation Sans";
    }
    DlgButton { x: 399px; y: 470px; width: 75px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
}

export struct InkLevel {
    name: string,
    color: color,
    // 0..100, or -1 when the printer reports no value
    level: int,
}

// Ink meter (EPInkMeterLib, 30x42 DLU): a tank that fills from the bottom.
component InkMeter inherits Rectangle {
    in property <InkLevel> ink;
    background: #ffffff;
    border-width: 1px;
    border-color: #808080;
    Rectangle {
        x: 1px;
        width: parent.width - 2px;
        height: (parent.height - 2px) * max(root.ink.level, 0) / 100;
        y: parent.height - 1px - self.height;
        background: root.ink.color;
    }
    if root.ink.level < 0: DlgText {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "?";
    }
}

// EPSON Status Monitor 3, E_IASRG5P dialog 102 (319x419 DLU template),
// as Windows arranges it when opened from the Maintenance tab
// (E_IAPRG5P FUN_180033c9c, "detail" mode). Views status + ink levels +
// buttons are stacked, giving a 479x412 px client on a white background.
// Rectangles from phase2/layout/LAYOUT.json "sm3.runtime.detail".
export component StatusMonitorDialog inherits UtilityWindow {
    in property <string> printer: "L800";
    in property <string> title-text;
    in property <string> body;
    in property <[InkLevel]> inks;
    // Meaning of E_IASRG5P 30699.
    in property <string> note: "The ink levels shown are estimates and can differ from the real levels. To be sure, look at the ink tanks on the printer.";
    callback ok();
    callback print-queue();
    title: "EPSON Status Monitor 3 : " + root.printer;
    width: 479px;
    height: 412px;
    background: #ffffff;
    default-action => { root.ok(); }
    cancel-action => { root.ok(); }
    // 377 (8,8,120x42) is Epson's banner bitmap: the space stays empty.
    // 384 short status title (135,8,336x41), LTEXT (top-aligned), Tahoma 12 pt.
    DlgText { x: 135px; y: 8px; width: 336px; height: 41px; text: root.title-text; font-size: 16px; }
    // 212 read-only multi-line EDIT (8,57,336x97) with WS_BORDER|WS_VSCROLL:
    // the 17 px scroll bar strip is always there (inactive while the text fits).
    Rectangle {
        x: 8px; y: 57px; width: 336px; height: 97px;
        background: #ffffff;
        border-width: 1px;
        border-color: #828790;
        DlgText { x: 4px; y: 3px; width: parent.width - 1px - 17px - 6px; height: parent.height - 6px; text: root.body; }
        Rectangle { x: parent.width - 1px - 17px; y: 1px; width: 17px; height: parent.height - 2px; background: #f0f0f0; }
    }
    // 210 printer picture (351,57,120x98): WS_BORDER (1 px black) + SS_SUNKEN.
    Rectangle {
        x: 351px; y: 57px; width: 120px; height: 98px;
        border-width: 1px;
        border-color: #000000;
        Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: #a0a0a0; }
        Rectangle { x: 1px; y: 1px; width: 1px; height: parent.height - 2px; background: #a0a0a0; }
        Rectangle { x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px; background: #ffffff; }
        Rectangle { x: parent.width - 2px; y: 1px; width: 1px; height: parent.height - 2px; background: #ffffff; }
        Image { x: (parent.width - 76px) / 2; y: (parent.height - 72px) / 2; width: 76px; height: 72px; source: @image-url("icons/printer.svg"); }
    }
    // 30602 group box "Approximate Ink Levels" (8,195,464x172).
    Rectangle {
        x: 8px; y: 201px; width: 464px; height: 166px;
        border-width: 1px;
        border-color: #c8c8c8;
        border-radius: 3px;
    }
    Rectangle { x: 14px; y: 195px; width: 130px; height: 14px; background: #ffffff;
        DlgText { x: 3px; text: "Approximate Ink Levels"; wrap: no-wrap; }
    }
    // Meters 390-395 (x 33 + 73.4n, 211, 45x68) and names 2700-2705 (x 20 + 73.4n, 288, 72x26).
    for ink[n] in root.inks: Rectangle {
        property <[length]> xs: [20px, 93px, 167px, 240px, 314px, 387px];
        x: self.xs[n];
        y: 211px;
        width: 72px;
        height: 103px;
        InkMeter { x: 13px; y: 0; width: 45px; height: 68px; ink: ink; }
        DlgText { x: 0; y: 77px; width: 72px; height: 26px; text: ink.name; horizontal-alignment: center; }
    }
    // 30601 note (15,325,428x39).
    DlgText { x: 15px; y: 325px; width: 428px; height: 39px; text: root.note; }
    // 410 "Print Queue" (8,379,113x23) and IDOK "OK" (209,379,83x23, default).
    DlgButton { x: 8px; y: 379px; width: 113px; height: 23px; text: "Print Queue"; clicked => { root.print-queue(); } }
    DlgButton { x: 209px; y: 379px; width: 83px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
}
