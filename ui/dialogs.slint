// Printing Preferences sub-dialogs (E_IUIRG5P popups, LAYOUT.json
// printing_preferences.subdialogs), at their pixel rectangles.
//
// - ColorControlsDialog (4300): working, mapped to the PPD colour options.
// - LayoutDialog: any other sub-dialog drawn from a control table (src/layouts.rs)
//   with every control disabled and a tooltip that says why. OK, Cancel
//   and Close just close it.

import { Slider } from "std-widgets.slint";
import { Strings, DlgText, EtchedLine, DlgButton, UtilityWindow, Group, CheckBox, Radio, Combo } from "common.slint";

// One slider row of dialog 4300: label, value box (EDITTEXT + owner-draw
// sign, 74..104 px), "-" trackbar "+", -25..25.
component ColorSlider inherits Rectangle {
    in property <string> label;
    in-out property <int> value;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <length> label-x;
    in property <length> box-x;
    in property <length> slider-x;
    callback changed;
    DlgText { x: root.label-x; y: 5px; width: 53px; height: 15px; text: root.label; wrap: no-wrap; color: root.enabled ? #000000 : #8a8a8a; }
    Rectangle {
        x: root.box-x;
        y: 3px;
        width: 32px;
        height: 20px;
        background: root.enabled ? #ffffff : #f4f4f4;
        border-width: 1px;
        border-color: #7a7a7a;
        DlgText {
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: root.value > 0 ? "+" + root.value : root.value;
            color: root.enabled ? #000000 : #8a8a8a;
        }
    }
    DlgText { x: root.slider-x - 6px; y: 15px; width: 8px; height: 13px; text: "-"; horizontal-alignment: center; }
    Slider {
        x: root.slider-x;
        y: 0;
        width: 131px;
        height: 20px;
        minimum: -25;
        maximum: 25;
        step: 1;
        value: root.value;
        enabled: root.enabled;
        changed(v) => {
            root.value = Math.round(v);
            root.changed();
        }
    }
    DlgText { x: root.slider-x + 131px; y: 15px; width: 8px; height: 13px; text: "+"; horizontal-alignment: center; }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// Dialog 4300 "Color Controls" (370x305 DLU = 555x496 px), Advanced >
// Color Management > Settings... Slide Bar mode: Color Mode, Gamma,
// Brightness, Contrast, Saturation, Cyan, Magenta, Yellow map to the PPD
// options CorrectionColor, GammaValue, BrightnessValue, ContrastValue,
// SaturationValue, CyanValue, MagentaValue, YellowValue (-25..25).
export component ColorControlsDialog inherits UtilityWindow {
    in property <[string]> color-mode-labels;
    in property <[string]> gamma-labels;
    in-out property <int> color-mode;
    in-out property <int> gamma;
    in-out property <int> brightness;
    in-out property <int> contrast;
    in-out property <int> saturation;
    in-out property <int> cyan;
    in-out property <int> magenta;
    in-out property <int> yellow;
    callback ok();
    callback cancel();
    property <bool> vivid: root.color-mode == 1;
    title: "Color Controls";
    width: 555px;
    height: 496px;
    default-action => { root.ok(); }
    cancel-action => { root.cancel(); }

    Group { x: 8px; y: 7px; width: 539px; height: 447px; title: "Color Controls"; page: #f0f0f0; }
    DlgText { x: 20px; y: 67px; width: 108px; height: 16px; text: "Color Mode"; wrap: no-wrap; }
    Combo {
        x: 20px; y: 85px; width: 239px;
        model: root.color-mode-labels;
        current-index <=> root.color-mode;
        selected => {
            if (root.vivid) {
                // Gamma 1.8 is not allowed with EPSON Vivid.
                root.gamma = 1;
            }
        }
    }
    DlgText { x: 20px; y: 115px; width: 50px; height: 16px; text: "Gamma"; wrap: no-wrap; }
    Combo {
        x: 20px; y: 133px; width: 239px;
        model: root.gamma-labels;
        current-index <=> root.gamma;
        enabled: !root.vivid;
        tip: root.vivid ? "Gamma 1.8 cannot be used with EPSON Vivid." : "";
    }
    Group { x: 18px; y: 164px; width: 240px; height: 52px; title: "Color Adjustment Method"; page: #f0f0f0; }
    Radio { x: 32px; y: 187px; width: 86px; height: 16px; text: "Color Circle"; enabled: false; tip: "The Linux driver takes the slide-bar values only."; }
    Radio { x: 147px; y: 187px; width: 96px; height: 16px; text: "Slide Bar"; checked: true; }
    DlgButton {
        x: 162px; y: 224px; width: 93px; height: 23px; text: "Reset Controls";
        clicked => {
            root.brightness = 0;
            root.contrast = 0;
            root.saturation = 0;
            root.cyan = 0;
            root.magenta = 0;
            root.yellow = 0;
        }
    }
    // Left column: Brightness, Contrast, Saturation, Density (y 255, 307, 359, 411).
    ColorSlider { x: 0; y: 255px; width: 270px; height: 30px; label: "Brightness"; value <=> root.brightness; label-x: 21px; box-x: 74px; slider-x: 117px; }
    ColorSlider { x: 0; y: 307px; width: 270px; height: 30px; label: "Contrast"; value <=> root.contrast; label-x: 21px; box-x: 74px; slider-x: 117px; }
    ColorSlider { x: 0; y: 359px; width: 270px; height: 30px; label: "Saturation"; value <=> root.saturation; label-x: 21px; box-x: 74px; slider-x: 117px; }
    ColorSlider { x: 0; y: 411px; width: 270px; height: 30px; label: "Density"; enabled: false; tip: Strings.no-linux; label-x: 21px; box-x: 74px; slider-x: 117px; }
    // Right column (Slide Bar mode): Cyan, Magenta, Yellow (y 255, 307, 359).
    ColorSlider { x: 0; y: 255px; width: 555px; height: 30px; label: "Cyan"; value <=> root.cyan; label-x: 302px; box-x: 354px; slider-x: 398px; }
    ColorSlider { x: 0; y: 307px; width: 555px; height: 30px; label: "Magenta"; value <=> root.magenta; label-x: 302px; box-x: 354px; slider-x: 398px; }
    ColorSlider { x: 0; y: 359px; width: 555px; height: 30px; label: "Yellow"; value <=> root.yellow; label-x: 302px; box-x: 354px; slider-x: 398px; }
    // Owner-draw colour chips 4352-4354 (278, y, 17x18).
    for chip[i] in [#00a0e0, #d0168c, #f0c800]: Rectangle {
        x: 278px; y: 258px + i * 54px; width: 17px; height: 18px;
        background: chip;
        border-width: 1px;
        border-color: #7a7a7a;
    }
    // 4360 / 4362 (93x158): our own sample picture, original and an
    // approximate preview of brightness and the C/M/Y shifts.
    Rectangle {
        x: 288px; y: 28px; width: 93px; height: 158px; clip: true;
        Image { width: 100%; height: 100%; source: @image-url("icons/sample-photo.svg"); image-fit: cover; }
    }
    DlgText { x: 282px; y: 190px; width: 105px; height: 13px; text: "<Original Photo>"; horizontal-alignment: center; wrap: no-wrap; }
    DlgText { x: 384px; y: 92px; width: 32px; height: 24px; text: "→"; font-size: 20px; horizontal-alignment: center; color: #3a7bd5; }
    Rectangle {
        x: 419px; y: 28px; width: 93px; height: 158px; clip: true;
        Image { width: 100%; height: 100%; source: @image-url("icons/sample-photo.svg"); image-fit: cover; }
        // Lighter/darker, then a tint away from the colours that were reduced.
        Rectangle { background: root.brightness > 0 ? #ffffff : #000000; opacity: abs(root.brightness) / 60; }
        Rectangle {
            background: rgb(128 - root.cyan * 5, 128 - root.magenta * 5, 128 - root.yellow * 5);
            opacity: (abs(root.cyan) + abs(root.magenta) + abs(root.yellow)) / 180;
        }
    }
    DlgText { x: 425px; y: 190px; width: 83px; height: 13px; text: "<Preview>"; horizontal-alignment: center; wrap: no-wrap; }

    DlgButton { x: 306px; y: 463px; width: 69px; height: 23px; text: "OK"; primary: true; clicked => { root.ok(); } }
    DlgButton { x: 393px; y: 463px; width: 69px; height: 23px; text: "Cancel"; clicked => { root.cancel(); } }
    DlgButton { x: 480px; y: 463px; width: 69px; height: 23px; text: "Help"; enabled: false; tip: "No help file on Linux."; }
}

export enum LayoutKind { Text, CText, Group, Check, Radio, Combo, Edit, Button, Slider, List, Frame, Line, UpDown }

export struct LayoutControl {
    kind: LayoutKind,
    x: int,
    y: int,
    w: int,
    h: int,
    text: string,
}

// A sub-dialog drawn from its control table, everything off.
export component LayoutDialog inherits UtilityWindow {
    in property <string> caption;
    in property <string> reason;
    in property <int> client-w;
    in property <int> client-h;
    in property <[LayoutControl]> controls;
    callback dismiss();
    title: root.caption;
    width: root.client-w * 1px;
    height: root.client-h * 1px;
    default-action => { root.dismiss(); }
    cancel-action => { root.dismiss(); }
    for c in root.controls: Rectangle {
        property <bool> closes: c.text == "OK" || c.text == "Cancel" || c.text == "Close";
        x: c.x * 1px;
        y: c.y * 1px;
        width: c.w * 1px;
        height: c.h * 1px;
        if c.kind == LayoutKind.Text || c.kind == LayoutKind.CText: DlgText {
            width: 100%;
            height: 100%;
            text: c.text;
            color: #6d6d6d;
            horizontal-alignment: c.kind == LayoutKind.CText ? center : left;
        }
        if c.kind == LayoutKind.Group: Group { width: 100%; height: 100%; title: c.text; page: #f0f0f0; }
        if c.kind == LayoutKind.Check: CheckBox { width: 100%; height: 100%; text: c.text; enabled: false; }
        if c.kind == LayoutKind.Radio: Radio { width: 100%; height: 100%; text: c.text; enabled: false; }
        if c.kind == LayoutKind.Combo: Combo { width: 100%; height: 100%; model: []; enabled: false; }
        if c.kind == LayoutKind.Edit || c.kind == LayoutKind.List: Rectangle { background: #f4f4f4; border-width: 1px; border-color: #a0a0a0; }
        if c.kind == LayoutKind.Frame: Rectangle { border-width: 1px; border-color: #c0c0c0; }
        if c.kind == LayoutKind.Line: EtchedLine { width: 100%; }
        if c.kind == LayoutKind.UpDown: Rectangle {
            background: #f0f0f0;
            border-width: 1px;
            border-color: #a0a0a0;
            Text { text: "▲\n▼"; font-size: 7px; color: #a0a0a0; horizontal-alignment: center; vertical-alignment: center; }
        }
        if c.kind == LayoutKind.Slider: Slider { width: 100%; height: 100%; enabled: false; }
        if c.kind == LayoutKind.Button: DlgButton {
            width: 100%;
            height: 100%;
            text: c.text;
            enabled: closes;
            primary: c.text == "OK";
            clicked => { root.dismiss(); }
        }
        if !closes: Tooltip { text: @markdown("\{root.reason}"); }
    }
}
