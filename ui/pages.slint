// The four settings pages of the Windows L800 Printing Preferences, at the
// pixel rectangles of E_IUIRG5P dialogs 904 (Shortcuts), 900 (Main), 901
// (Advanced) and 902 (Page Layout); 443x434 px each (phase2/layout/LAYOUT.md §7).
//
// Values live in the `Prefs` global; Rust fills the lists and loads/saves the
// values (src/settings.rs). Controls with no Linux equivalent are shown
// disabled with a tooltip that says why (phase2/rea/SETTINGS.md §2).
// Overlapping model-dependent controls whose L800 visibility is not settled
// yet are left out (see README).

import { Strings, DlgText, EtchedLine, DlgButton, Group, CheckBox, Radio, Combo, Spin, NumberSpin, List, InkLevel, InkMeter } from "common.slint";
import { Slider } from "std-widgets.slint";

export global Prefs {
    // Lists (Windows labels), set from Rust. Type, Size, Output Paper and the
    // Advanced quality list depend on the source (Sheet, the hidden
    // borderless source, CD/DVD) and are refilled after every edit; the
    // `-pos` values are the selected row in them.
    in property <[string]> source-labels;
    in property <[string]> media-labels;
    in property <[string]> size-labels;
    in property <[string]> output-labels;
    in property <[string]> color-mode-labels;
    in property <[string]> gamma-labels;
    in property <[string]> preset-labels;
    in property <[string]> adv-quality-labels;
    in-out property <int> media-pos;
    in-out property <int> size-pos;
    in-out property <int> output-pos;
    in-out property <int> adv-quality-pos;
    in property <[bool]> source-borderless;
    in property <[bool]> media-borderless;
    in property <[bool]> size-borderless;
    in property <[string]> quality-labels;
    // Any printer but the L800 (src/ppd_sheet.rs): the lists and values come
    // from its PPD, and controls whose option it lacks are greyed out.
    in property <bool> ppd-mode;
    in property <[bool]> quality-enabled: [true, true, true, true, true];
    in property <bool> has-quality: true;
    in property <bool> has-source: true;
    in property <bool> has-media: true;
    in property <bool> has-size: true;
    in property <bool> has-grayscale: true;
    in property <bool> has-color-mode: true;
    in property <bool> has-gamma: true;
    in property <bool> has-color-controls: true;
    in property <bool> has-printer-options;
    in property <bool> ppd-borderless-allowed;
    // Values.
    in-out property <int> quality;
    in-out property <int> source;
    in-out property <int> media;
    in-out property <int> size;
    in-out property <bool> borderless;
    in-out property <bool> landscape;
    in-out property <bool> grayscale;
    in-out property <bool> reverse;
    in-out property <int> color-mode;
    in-out property <int> gamma;
    in-out property <bool> reduce;
    in-out property <bool> by-percent;
    in-out property <int> output-size;
    in-out property <int> scale: 100;
    in-out property <bool> multi-page;
    in-out property <bool> poster;
    in-out property <int> pages-index;
    in-out property <int> poster-index;
    in-out property <bool> page-borders;
    in-out property <int> copies: 1;
    in-out property <bool> collate;
    in-out property <bool> rotate180;
    in-out property <bool> mirror;
    // Color Controls (dialog 4300), -25..25 each.
    in-out property <int> brightness;
    in-out property <int> contrast;
    in-out property <int> saturation;
    in-out property <int> cyan;
    in-out property <int> magenta;
    in-out property <int> yellow;
    in-out property <int> preset: -1;
    // Something changed since the last load/save (enables Apply).
    in-out property <bool> dirty;
    // Bumped by Rust before saving: number edits show the saved value.
    in property <int> commit-tick;
    // Approximate ink levels from one status query when the sheet opens.
    in property <[InkLevel]> inks;
    // The Current Settings window (dialog 4050) is open.
    in property <bool> settings-shown;
    callback toggle-settings();
    out property <bool> borderless-allowed: root.ppd-mode ? root.ppd-borderless-allowed :
        root.source-borderless[root.source] && root.media-borderless[root.media] && root.size-borderless[root.size];
    // Index of the first size that needs Reduce/Enlarge (A3, A3+, A2, B4, B3).
    in property <int> first-document-size: 16;
    out property <bool> needs-reduce: !root.ppd-mode && root.size >= root.first-document-size;
    out property <bool> vivid: !root.ppd-mode && root.color-mode == 1;
    // Plain sheet feed: Reduce/Enlarge works only here (FUN_68f8d8e4). It
    // is an L800 PPD option, so other printers have none.
    out property <bool> sheet-feed: !root.ppd-mode && root.source == 0 && !(root.borderless && root.borderless-allowed);
    callback reset-defaults();
    callback preset-picked(int);
    // Any edit (Rust refreshes the Current Settings window).
    callback edited();
    // A row picked in a source-dependent list: "media", "size", "output", "quality".
    callback pick(string, int);
    // Open a sub-dialog: "color-controls", "custom-settings", "page-order",
    // "poster", "margins", "watermark", "printer-options".
    callback open-dialog(string);

    // After every edit: mark dirty; Rust (`edited`) then applies the PPD
    // constraints (settings.rs `Values::constrained`, SETTINGS.md §1) and
    // refills the lists.
    public function changed() {
        root.dirty = true;
        root.preset = -1;
        root.edited();
    }
}

component QualityIcon inherits Rectangle {
    in property <image> source;
    in property <int> level;
    in property <bool> enabled: true;
    width: 42px;
    height: 52px;
    Image { source: root.source; width: 100%; height: 100%; opacity: root.enabled ? 1.0 : 0.35; }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            Prefs.quality = root.level;
            Prefs.changed();
        }
    }
}

// Ink Levels group box: owner-draw meters, 23x54 px each, 25.5 px apart.
// Like Windows, they show the approximate levels from the printer status and
// stay empty when there is no status.
// Ink box (1977 / 5253): six boxes re-laid-out at run time to 27 px wide,
// 8 px apart (x = group + meter-x + 35n), C, M, LM, LC, K, Y (SETTINGS-visibility.md).
component InkBox inherits Group {
    in property <length> meter-x;
    in property <length> meter-y;
    title: "Approximate Ink Levels";
    // More than six inks sit closer, with narrower boxes.
    property <length> step: min(35px, (root.width - 2 * root.meter-x - 27px) / max(1, Prefs.inks.length - 1));
    for ink[i] in Prefs.inks: InkMeter {
        x: root.meter-x + i * root.step;
        y: root.meter-y;
        width: min(27px, root.step - 4px);
        height: 54px;
        ink: ink;
    }
}

// "Show Settings" / "Hide Settings" (strings 2050/2051): toggles the Current
// Settings window (dialog 4050).
component ShowSettingsButton inherits DlgButton {
    x: 355px;
    y: 403px;
    width: 80px;
    height: 23px;
    text: Prefs.settings-shown ? "Hide Settings" : "Show Settings";
    clicked => { Prefs.toggle-settings(); }
}

// The bottom rows shared by the pages.
component ShowFirstCheck inherits CheckBox {
    x: 307px;
    y: 384px;
    width: 128px;
    height: 13px;
    text: "Show this screen first";
    enabled: false;
    tip: Strings.windows-only;
}

component ResetDefaultsButton inherits DlgButton {
    x: 8px;
    y: 403px;
    width: 110px;
    height: 23px;
    text: "Reset Defaults";
    clicked => { Prefs.reset-defaults(); }
}

// Tidy layout (README "Printing Preferences"): the Windows controls, labels, sizes and
// grouping, on one grid: 8 px page margin, 6 px between group boxes,
// content 8 px below a group title and 8 px in from its frame, rows 22 px
// apart (check boxes, radios) or 26 px (combo boxes), side-by-side groups
// of equal height, and the bottom row (23 px buttons) at y 403, 8 px above
// the page bottom, with the "Show this screen first" row above it at 384.
// Hidden L800 controls leave no holes.

// Dialog 904 "Shortcuts". Columns: presets 8..209, ink 215..435.
export component ShortcutsPage inherits Rectangle {
    width: 443px;
    height: 434px;
    background: #ffffff;
    DlgText { x: 8px; y: 8px; width: 93px; height: 13px; text: "Printing Presets"; wrap: no-wrap; }
    // 5251 LISTBOX: presets from E_FUIXG5P.XML.
    List {
        x: 8px; y: 25px; width: 201px; height: 302px;
        model: Prefs.preset-labels;
        current-index: Prefs.preset;
        enabled: !Prefs.ppd-mode;
        selected => { Prefs.preset-picked(self.current-index); }
    }
    if Prefs.ppd-mode: Rectangle { x: 8px; y: 25px; width: 201px; height: 302px; Tooltip { text: @markdown("\{Strings.presets-l800}"); } }
    DlgButton { x: 129px; y: 333px; width: 80px; height: 23px; text: "Reset"; enabled: false; tip: Strings.windows-only; }
    CheckBox { x: 8px; y: 362px; width: 201px; height: 29px; text: "Do not display mouse-over messages for Printing Presets."; multiline: true; enabled: false; tip: Strings.windows-only; }
    // 5253, bottom-aligned with the list; How to Buy (5262) hidden, as on Main.
    InkBox { x: 215px; y: 244px; width: 220px; height: 83px; meter-x: 9px; meter-y: 21px; }
    CheckBox { x: 307px; y: 362px; width: 92px; height: 13px; text: "Print Preview"; enabled: false; tip: Strings.windows-only; }
    ShowFirstCheck { }
    DlgButton { x: 8px; y: 403px; width: 105px; height: 23px; text: "Add/Remove..."; enabled: false; tip: Strings.windows-only; }
    DlgButton { x: 119px; y: 403px; width: 102px; height: 23px; text: "Technical Support"; enabled: false; tip: Strings.windows-only; }
    ShowSettingsButton { }
}

// Dialog 900 "Main". Rows: Quality 8..108; Paper | Print Options 114..247;
// Ink Levels | Orientation 253..355. Columns 8..263 and 269..435.
export component MainPage inherits Rectangle {
    width: 443px;
    height: 434px;
    background: #ffffff;
    Group { x: 8px; y: 8px; width: 427px; height: 100px; title: "Quality Option"; }
    // Five equal columns; each picture and radio is centred in its column.
    for q[i] in [
        { c: 51px, w: 45px, icon: @image-url("icons/quality-draft.svg") },
        { c: 136px, w: 42px, icon: @image-url("icons/quality-text.svg") },
        { c: 222px, w: 90px, icon: @image-url("icons/quality-textimage.svg") },
        { c: 307px, w: 48px, icon: @image-url("icons/quality-photo.svg") },
        { c: 392px, w: 86px, icon: @image-url("icons/quality-bestphoto.svg") },
    ]: Rectangle {
        QualityIcon { x: q.c - 21px; y: 29px; level: i; source: q.icon; enabled: Prefs.quality-enabled[i]; }
        Radio {
            x: q.c - q.w / 2; y: 87px; width: q.w; height: 13px;
            text: Prefs.quality-labels[i];
            enabled: Prefs.quality-enabled[i];
            tip: Prefs.quality-enabled[i] ? "" : Strings.not-in-ppd;
            checked: Prefs.quality == i;
            picked => {
                Prefs.quality = i;
                Prefs.changed();
            }
        }
    }

    Group { x: 8px; y: 114px; width: 255px; height: 133px; title: "Paper Options"; }
    DlgText { x: 16px; y: 139px; width: 38px; height: 13px; text: "Source"; wrap: no-wrap; horizontal-alignment: right; }
    Combo { x: 60px; y: 135px; width: 195px; model: Prefs.source-labels; current-index <=> Prefs.source; enabled: Prefs.has-source; tip: Prefs.has-source ? "" : Strings.not-in-ppd; selected => { Prefs.changed(); } }
    DlgText { x: 16px; y: 165px; width: 38px; height: 13px; text: "Type"; wrap: no-wrap; horizontal-alignment: right; }
    Combo { x: 60px; y: 161px; width: 195px; model: Prefs.media-labels; current-index <=> Prefs.media-pos; enabled: Prefs.has-media; tip: Prefs.has-media ? "" : Strings.not-in-ppd; selected => { Prefs.pick("media", self.current-index); } }
    DlgText { x: 16px; y: 191px; width: 38px; height: 13px; text: "Size"; wrap: no-wrap; horizontal-alignment: right; }
    Combo { x: 60px; y: 187px; width: 195px; model: Prefs.size-labels; current-index <=> Prefs.size-pos; enabled: Prefs.has-size; tip: Prefs.has-size ? "" : Strings.not-in-ppd; selected => { Prefs.pick("size", self.current-index); } }
    // On the same row as Quiet Mode, so both groups end together.
    Radio {
        x: 60px; y: 226px; width: 60px; height: 13px; text: "Borders";
        checked: !Prefs.borderless || !Prefs.borderless-allowed;
        picked => { Prefs.borderless = false; Prefs.changed(); }
    }
    Radio {
        x: 140px; y: 226px; width: 86px; height: 13px; text: "Borderless";
        enabled: Prefs.borderless-allowed;
        tip: Prefs.borderless-allowed ? "" : Strings.borderless-off;
        checked: Prefs.borderless && Prefs.borderless-allowed;
        picked => { Prefs.borderless = true; Prefs.changed(); }
    }

    Group { x: 269px; y: 114px; width: 166px; height: 133px; title: "Print Options"; }
    CheckBox { x: 277px; y: 135px; width: 92px; height: 13px; text: "PhotoEnhance"; enabled: false; tip: Strings.no-linux; }
    CheckBox { x: 277px; y: 157px; width: 92px; height: 13px; text: "Fix Red-Eye"; enabled: false; tip: Strings.no-linux; }
    CheckBox { x: 277px; y: 179px; width: 92px; height: 13px; text: "Reverse Order"; checked <=> Prefs.reverse; toggled => { Prefs.changed(); } }
    CheckBox { x: 277px; y: 201px; width: 92px; height: 13px; text: "Print Preview"; enabled: false; tip: Strings.windows-only; }
    EtchedLine { x: 277px; y: 219px; width: 150px; }
    // 1997: the L800 capability bits show it (SETTINGS.md §4); the PPD has no quiet mode.
    CheckBox { x: 277px; y: 226px; width: 105px; height: 13px; text: "Quiet Mode"; enabled: false; tip: Strings.quiet-off; }

    // 1977, retitled to string 2082 at run time; meters centred.
    InkBox { x: 8px; y: 253px; width: 255px; height: 102px; meter-x: 26px; meter-y: 31px; }

    Group { x: 269px; y: 253px; width: 166px; height: 102px; title: "Orientation"; }
    Radio { x: 277px; y: 285px; width: 75px; height: 13px; text: "Portrait"; checked: !Prefs.landscape; picked => { Prefs.landscape = false; Prefs.changed(); } }
    Radio { x: 277px; y: 307px; width: 78px; height: 13px; text: "Landscape"; checked: Prefs.landscape; picked => { Prefs.landscape = true; Prefs.changed(); } }
    Image { x: 359px; y: 274px; width: 68px; height: 73px; source: Prefs.landscape ? @image-url("icons/orient-landscape.svg") : @image-url("icons/orient-portrait.svg"); }

    ShowFirstCheck { }
    ResetDefaultsButton { }
    DlgButton { x: 124px; y: 403px; width: 102px; height: 23px; text: "Technical Support"; enabled: false; tip: Strings.windows-only; }
    ShowSettingsButton { }
}

// Dialog 901 "Advanced". The four combos of "Paper & Quality Options" are
// read in template order as Source, Type, Quality, Size (M).
// Left column 8..218: Paper & Quality 8..155, Orientation 161..203, Print
// Options 209..368, then the custom settings row 374..397. Right column 224..435: Color Management 8..203, level
// with Orientation (the L800 hides the PhotoEnhance/ICM panels below it).
export component AdvancedPage inherits Rectangle {
    width: 443px;
    height: 434px;
    background: #ffffff;
    Group { x: 8px; y: 8px; width: 210px; height: 147px; title: "Paper & Quality Options"; }
    Combo { x: 16px; y: 29px; width: 194px; model: Prefs.source-labels; current-index <=> Prefs.source; enabled: Prefs.has-source; tip: Prefs.has-source ? "" : Strings.not-in-ppd; selected => { Prefs.changed(); } }
    Combo { x: 16px; y: 55px; width: 194px; model: Prefs.media-labels; current-index <=> Prefs.media-pos; enabled: Prefs.has-media; tip: Prefs.has-media ? "" : Strings.not-in-ppd; selected => { Prefs.pick("media", self.current-index); } }
    // 3105 Print Quality: the print modes of this paper type (strings 1400-1430).
    Combo { x: 16px; y: 81px; width: 194px; model: Prefs.adv-quality-labels; current-index <=> Prefs.adv-quality-pos; enabled: Prefs.has-quality; tip: Prefs.has-quality ? "" : Strings.not-in-ppd; selected => { Prefs.pick("quality", self.current-index); } }
    Combo { x: 16px; y: 107px; width: 194px; model: Prefs.size-labels; current-index <=> Prefs.size-pos; enabled: Prefs.has-size; tip: Prefs.has-size ? "" : Strings.not-in-ppd; selected => { Prefs.pick("size", self.current-index); } }
    Radio {
        x: 16px; y: 134px; width: 68px; height: 13px; text: "Borders";
        checked: !Prefs.borderless || !Prefs.borderless-allowed;
        picked => { Prefs.borderless = false; Prefs.changed(); }
    }
    Radio {
        x: 104px; y: 134px; width: 83px; height: 13px; text: "Borderless";
        enabled: Prefs.borderless-allowed;
        tip: Prefs.borderless-allowed ? "" : Strings.borderless-off;
        checked: Prefs.borderless && Prefs.borderless-allowed;
        picked => { Prefs.borderless = true; Prefs.changed(); }
    }

    Group { x: 8px; y: 161px; width: 210px; height: 42px; title: "Orientation"; }
    Radio { x: 16px; y: 182px; width: 68px; height: 13px; text: "Portrait"; checked: !Prefs.landscape; picked => { Prefs.landscape = false; Prefs.changed(); } }
    Radio { x: 104px; y: 182px; width: 75px; height: 13px; text: "Landscape"; checked: Prefs.landscape; picked => { Prefs.landscape = true; Prefs.changed(); } }

    Group { x: 8px; y: 209px; width: 210px; height: 159px; title: "Print Options"; }
    CheckBox { x: 16px; y: 230px; width: 105px; height: 13px; text: "Fix Red-Eye"; enabled: false; tip: Strings.no-linux; }
    CheckBox { x: 16px; y: 252px; width: 105px; height: 13px; text: "High Speed"; enabled: false; tip: "No Linux option: the L800 filter chooses the print direction for each quality."; }
    CheckBox { x: 16px; y: 274px; width: 105px; height: 13px; text: "Edge Smoothing"; enabled: false; tip: Strings.no-linux; }
    CheckBox { x: 16px; y: 296px; width: 105px; height: 13px; text: "Print Preview"; enabled: false; tip: Strings.windows-only; }
    // 3115 Grayscale: the L800's only colour switch (PPD Color=Grayscale).
    CheckBox { x: 16px; y: 318px; width: 105px; height: 13px; text: "Grayscale"; checked <=> Prefs.grayscale; enabled: Prefs.has-grayscale; tip: Prefs.has-grayscale ? "" : Strings.not-in-ppd; toggled => { Prefs.changed(); } }
    EtchedLine { x: 16px; y: 340px; width: 194px; }
    CheckBox { x: 16px; y: 347px; width: 105px; height: 13px; text: "Quiet Mode"; enabled: false; tip: Strings.quiet-off; }

    Group { x: 224px; y: 8px; width: 211px; height: 195px; title: "Color Management"; }
    Radio { x: 232px; y: 29px; width: 90px; height: 13px; text: "Color Controls"; checked: true; }
    Radio { x: 232px; y: 51px; width: 135px; height: 13px; text: "PhotoEnhance"; enabled: false; tip: Strings.no-linux; }
    Radio { x: 232px; y: 73px; width: 86px; height: 13px; text: "ICM"; enabled: false; tip: "No driver ICM on Linux: use colour management in the application or colord."; }
    EtchedLine { x: 232px; y: 93px; width: 195px; }
    DlgText { x: 232px; y: 106px; width: 57px; height: 13px; text: "Color Mode"; wrap: no-wrap; }
    Combo { x: 297px; y: 102px; width: 130px; model: Prefs.color-mode-labels; current-index <=> Prefs.color-mode; enabled: Prefs.has-color-mode; tip: Prefs.has-color-mode ? "" : Strings.not-in-ppd; selected => { Prefs.changed(); } }
    DlgText { x: 232px; y: 132px; width: 57px; height: 13px; text: "Gamma"; wrap: no-wrap; }
    Combo { x: 297px; y: 128px; width: 130px; model: Prefs.gamma-labels; current-index <=> Prefs.gamma; enabled: Prefs.has-gamma && !Prefs.vivid; tip: !Prefs.has-gamma ? Strings.not-in-ppd : Prefs.vivid ? Strings.gamma-vivid : ""; selected => { Prefs.changed(); } }
    DlgButton { x: 346px; y: 172px; width: 81px; height: 23px; text: "Settings..."; enabled: Prefs.has-color-controls; tip: Prefs.has-color-controls ? "" : Strings.not-in-ppd; clicked => { Prefs.open-dialog("color-controls"); } }
    // Ours, for other printers: the PPD options no Windows control takes.
    if Prefs.ppd-mode: DlgButton {
        x: 224px; y: 209px; width: 110px; height: 23px; text: "Printer Options...";
        enabled: Prefs.has-printer-options;
        tip: Prefs.has-printer-options ? "" : Strings.no-printer-options;
        clicked => { Prefs.open-dialog("printer-options"); }
    }

    ShowFirstCheck { }
    ResetDefaultsButton { }
    DlgButton { x: 124px; y: 403px; width: 102px; height: 23px; text: "Technical Support"; enabled: false; tip: Strings.windows-only; }
    // Custom settings (3123) and Save Settings... (3124), under Print Options
    // and in the columns of the buttons below them.
    Combo { x: 8px; y: 375px; width: 110px; model: []; enabled: false; tip: Strings.windows-only; }
    DlgButton { x: 124px; y: 374px; width: 102px; height: 23px; text: "Save Settings..."; clicked => { Prefs.open-dialog("custom-settings"); } }
}

// Page Layout preview (owner-draw 3414): one sheet with the pages on it.
component LayoutPreview inherits Rectangle {
    property <int> cols: !Prefs.multi-page ? 1 : Prefs.poster ? [2, 2, 3, 4][Prefs.poster-index] : Prefs.pages-index == 0 ? 1 : 2;
    property <int> rows: !Prefs.multi-page ? 1 : Prefs.poster ? [1, 2, 3, 4][Prefs.poster-index] : 2;
    property <length> pw: Prefs.landscape ? 62px : 46px;
    property <length> ph: Prefs.landscape ? 46px : 62px;
    Rectangle {
        x: (parent.width - root.pw) / 2;
        y: (parent.height - root.ph) / 2;
        width: root.pw;
        height: root.ph;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;
        for i in root.cols * root.rows: Rectangle {
            x: 3px + Math.mod(i, root.cols) * (parent.width - 6px) / root.cols;
            y: 3px + Math.floor(i / root.cols) * (parent.height - 6px) / root.rows;
            width: (parent.width - 6px) / root.cols - 2px;
            height: (parent.height - 6px) / root.rows - 2px;
            background: Prefs.poster ? #dceefa : #f4f4f4;
            border-width: 1px;
            border-color: Prefs.poster ? #7fb5d9 : (Prefs.multi-page && Prefs.page-borders ? #303030 : #c8c8c8);
            if !Prefs.poster: Text {
                text: i + 1;
                font-size: 9px;
                color: #3a7bd5;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Collate picture (owner-draw 3431): two copies of a 3-page document.
component CollatePicture inherits Rectangle {
    property <[int]> order: Prefs.collate ? (Prefs.reverse ? [3, 2, 1, 3, 2, 1] : [1, 2, 3, 1, 2, 3]) : (Prefs.reverse ? [3, 3, 2, 2, 1, 1] : [1, 1, 2, 2, 3, 3]);
    for n[i] in root.order: Rectangle {
        x: 4px + i * 13px;
        y: 8px + Math.mod(i, 3) * 3px;
        width: 14px;
        height: 20px;
        background: #ffffff;
        border-width: 1px;
        border-color: #7a7a7a;
        Text { text: n; font-size: 9px; color: #3a7bd5; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Dialog 902 "Page Layout". Left 8..218: Layout 8..282, Watermark 288..380.
// Right 224..435: 2-sided 8..79, Copies 85..178, Borderless 184..306, More
// Options 312..380. Both columns end at 380 (this page has no bottom row).
export component PageLayoutPage inherits Rectangle {
    width: 443px;
    height: 434px;
    background: #ffffff;
    Group { x: 8px; y: 8px; width: 210px; height: 274px; title: "Layout"; }
    CheckBox {
        x: 16px; y: 29px; width: 155px; height: 13px; text: "Reduce/Enlarge Document";
        checked <=> Prefs.reduce;
        enabled: !Prefs.needs-reduce && Prefs.sheet-feed;
        tip: Prefs.ppd-mode ? Strings.not-in-ppd : Prefs.needs-reduce ? "This paper size is larger than the printer can print: it must be reduced." : "";
        toggled => { Prefs.changed(); }
    }
    Radio {
        x: 32px; y: 51px; width: 122px; height: 13px; text: "By Output Paper Size";
        enabled: Prefs.reduce && Prefs.sheet-feed; checked: !Prefs.by-percent;
        picked => { Prefs.by-percent = false; Prefs.changed(); }
    }
    Combo { x: 32px; y: 70px; width: 178px; model: Prefs.output-labels; current-index <=> Prefs.output-pos; enabled: Prefs.reduce && !Prefs.by-percent && Prefs.sheet-feed; selected => { Prefs.pick("output", self.current-index); } }
    Radio {
        x: 32px; y: 100px; width: 96px; height: 13px; text: "By Percentage";
        enabled: Prefs.reduce && Prefs.sheet-feed; checked: Prefs.by-percent;
        picked => { Prefs.by-percent = true; Prefs.changed(); }
    }
    NumberSpin { x: 134px; y: 97px; width: 56px; height: 20px; minimum: 10; maximum: 400; value <=> Prefs.scale; commit: Prefs.commit-tick; enabled: Prefs.reduce && Prefs.by-percent && Prefs.sheet-feed; changed => { Prefs.changed(); } }
    DlgText { x: 196px; y: 100px; width: 12px; height: 13px; text: "%"; }

    CheckBox { x: 16px; y: 135px; width: 75px; height: 13px; text: "Multi-Page"; checked <=> Prefs.multi-page; toggled => { Prefs.changed(); } }
    Radio {
        x: 32px; y: 157px; width: 116px; height: 13px; text: "Pages per Sheet";
        enabled: Prefs.multi-page; checked: !Prefs.poster;
        picked => { Prefs.poster = false; Prefs.changed(); }
    }
    Radio {
        x: 32px; y: 179px; width: 92px; height: 13px; text: "Poster Printing";
        enabled: Prefs.multi-page && !Prefs.ppd-mode; checked: Prefs.poster;
        tip: Prefs.ppd-mode ? Strings.not-in-ppd : "";
        picked => { Prefs.poster = true; Prefs.changed(); }
    }
    // 3410: "2" 3521, "4" 3522. 3416: 2x1 3503, 2x2 3500, 3x3 3501, 4x4 3502.
    if !Prefs.poster: Spin { x: 48px; y: 201px; width: 57px; height: 20px; labels: ["2", "4"]; index <=> Prefs.pages-index; enabled: Prefs.multi-page; changed => { Prefs.changed(); } }
    if Prefs.poster: Spin { x: 48px; y: 201px; width: 57px; height: 20px; labels: ["2x1", "2x2", "3x3", "4x4"]; index <=> Prefs.poster-index; enabled: Prefs.multi-page; changed => { Prefs.changed(); } }
    if !Prefs.poster: CheckBox { x: 32px; y: 229px; width: 110px; height: 13px; text: "Print Page Borders"; enabled: Prefs.multi-page; checked <=> Prefs.page-borders; toggled => { Prefs.changed(); } }
    // 3414: our own preview of the sheet layout (hidden while Multi-Page is off).
    if Prefs.multi-page: LayoutPreview { x: 141px; y: 157px; width: 69px; height: 75px; }
    DlgButton {
        x: 132px; y: 251px; width: 78px; height: 23px;
        text: Prefs.poster ? "Settings..." : "Page Order...";
        enabled: Prefs.multi-page;
        clicked => { Prefs.open-dialog(Prefs.poster ? "poster" : "page-order"); }
    }

    Group { x: 8px; y: 288px; width: 210px; height: 92px; title: "Watermark"; }
    // The PPD's watermark data paths (*epcgWatermarkData) point at
    // /home/epson/projects/..., which does not exist, so the filter cannot
    // draw watermarks (SETTINGS.md): shown, but off.
    Combo { x: 16px; y: 309px; width: 194px; model: ["None", "Confidential", "Draft", "Urgent", "Priority", "Hot", "Do Not Copy", "For Your Eyes Only", "Review Copy", "Top Secret", "Duplicate"]; current-index: 0; enabled: false; tip: "Off: the installed L800 driver points at watermark files that do not exist, so watermarks would not print."; }
    DlgButton { x: 16px; y: 342px; width: 84px; height: 23px; text: "Add/Del..."; enabled: false; tip: "No Linux option: the L800 driver has only the ten built-in watermarks."; }
    DlgButton { x: 106px; y: 342px; width: 84px; height: 23px; text: "Settings..."; clicked => { Prefs.open-dialog("watermark"); } }

    Group { x: 224px; y: 8px; width: 211px; height: 71px; title: "2-sided printing"; }
    Radio { x: 232px; y: 29px; width: 51px; height: 13px; text: "Off"; checked: true; enabled: false; tip: Strings.no-linux; }
    Radio { x: 296px; y: 29px; width: 51px; height: 13px; text: "On"; enabled: false; tip: Strings.no-linux; }
    DlgButton { x: 232px; y: 48px; width: 90px; height: 23px; text: "Margins..."; clicked => { Prefs.open-dialog("margins"); } }
    CheckBox { x: 330px; y: 53px; width: 95px; height: 13px; text: "Folded Booklet"; enabled: false; tip: Strings.no-linux; }

    Group { x: 224px; y: 85px; width: 211px; height: 93px; title: "Copies"; }
    DlgText { x: 232px; y: 109px; width: 40px; height: 13px; text: "Copies"; wrap: no-wrap; }
    NumberSpin { x: 276px; y: 106px; width: 61px; height: 20px; minimum: 1; maximum: 9999; value <=> Prefs.copies; commit: Prefs.commit-tick; changed => { Prefs.changed(); } }
    CheckBox { x: 232px; y: 132px; width: 89px; height: 13px; text: "Reverse Order"; checked <=> Prefs.reverse; toggled => { Prefs.changed(); } }
    CheckBox { x: 232px; y: 154px; width: 87px; height: 13px; text: "Collate"; checked <=> Prefs.collate; toggled => { Prefs.changed(); } }
    // 3431: our own collate picture.
    CollatePicture { x: 341px; y: 128px; width: 86px; height: 42px; }

    Group { x: 224px; y: 184px; width: 211px; height: 122px; title: "Borderless"; }
    DlgText { x: 232px; y: 205px; width: 131px; height: 13px; text: "Enlargement Method"; wrap: no-wrap; color: #8a8a8a; }
    Combo { x: 232px; y: 222px; width: 195px; model: ["Auto Expand", "Retain Size"]; current-index: 0; enabled: false; tip: "No Linux option: the L800 PPD has no borderless expansion control."; }
    DlgText { x: 232px; y: 260px; width: 50px; height: 13px; text: "Expansion"; wrap: no-wrap; color: #8a8a8a; }
    Slider { x: 288px; y: 249px; width: 139px; height: 36px; minimum: 0; maximum: 2; value: 2; enabled: false; }
    DlgText { x: 288px; y: 285px; width: 23px; height: 13px; text: "Min"; color: #8a8a8a; }
    DlgText { x: 346px; y: 285px; width: 23px; height: 13px; text: "Mid"; horizontal-alignment: center; color: #8a8a8a; }
    DlgText { x: 404px; y: 285px; width: 23px; height: 13px; text: "Max"; horizontal-alignment: right; color: #8a8a8a; }

    Group { x: 224px; y: 312px; width: 211px; height: 68px; title: "More Options"; }
    CheckBox { x: 232px; y: 333px; width: 83px; height: 13px; text: "Rotate 180°"; checked <=> Prefs.rotate180; enabled: !Prefs.ppd-mode; tip: Prefs.ppd-mode ? Strings.not-in-ppd : ""; toggled => { Prefs.changed(); } }
    CheckBox { x: 232px; y: 355px; width: 90px; height: 13px; text: "Mirror Image"; checked <=> Prefs.mirror; enabled: !Prefs.ppd-mode; tip: Prefs.ppd-mode ? Strings.not-in-ppd : ""; toggled => { Prefs.changed(); } }
}
